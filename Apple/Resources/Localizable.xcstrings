{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "%lld / %lld threads": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld / %2$lld 件"
          }
        }
      }
    },
    "%lld threads": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 件"
          }
        }
      }
    },
    "(No subject)": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "(件名なし)"
          }
        }
      }
    },
    "Checking": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "確認中"
          }
        }
      }
    },
    "Checking hey CLI…": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "hey CLI を確認しています…"
          }
        }
      }
    },
    "Couldn't mark as seen: %@": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "既読にできませんでした: %@"
          }
        }
      }
    },
    "Error": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エラー"
          }
        }
      }
    },
    "Example: /opt/homebrew/bin/hey": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "例: /opt/homebrew/bin/hey"
          }
        }
      }
    },
    "hey command not found. Set its location in Settings (⌘,).": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "hey コマンドが見つかりません。設定 (⌘,) で場所を指定してください。"
          }
        }
      }
    },
    "hey exited with code %d: %@": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "hey が終了コード %1$d で失敗しました: %2$@"
          }
        }
      }
    },
    "hey location": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "hey の場所"
          }
        }
      }
    },
    "hey not found": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "hey なし"
          }
        }
      }
    },
    "Leave empty to search automatically": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "空なら自動で探す"
          }
        }
      }
    },
    "Loading Imbox…": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Imbox を読み込んでいます…"
          }
        }
      }
    },
    "Loading the rest…": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "残りを読み込み中"
          }
        }
      }
    },
    "Logged in": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ログイン中"
          }
        }
      }
    },
    "Logged out": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "未ログイン"
          }
        }
      }
    },
    "Newest first": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しい順"
          }
        }
      }
    },
    "Not logged in. Run `hey auth login` in Terminal.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ログインしていません。ターミナルで `hey auth login` を実行してください。"
          }
        }
      }
    },
    "Oldest first": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "古い順"
          }
        }
      }
    },
    "Open in Browser": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ブラウザで開く"
          }
        }
      }
    },
    "Open This Email": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このメールを開く"
          }
        }
      }
    },
    "Press r to check again.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "r で再確認します。"
          }
        }
      }
    },
    "Reload with This Setting": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この設定で読み直す"
          }
        }
      }
    },
    "Search (/)": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "検索 (/)"
          }
        }
      }
    },
    "Select a thread": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スレッドを選んでください"
          }
        }
      }
    },
    "Server search: %lld": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバ検索 %lld 件"
          }
        }
      }
    },
    "Sort": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "並び"
          }
        }
      }
    },
    "Unread %lld": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "未読 %lld"
          }
        }
      }
    },
    "Unread only (u)": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "未読のみ (u)"
          }
        }
      }
    }
  }
}